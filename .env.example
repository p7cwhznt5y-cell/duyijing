# 环境变量示例 —— 不要把真实密钥提交到版本库
# 部署时在平台后台配置环境变量即可

# === DeepSeek AI 解读 API（必填，Worker 代理调用）===
# Vercel：项目 Settings → Environment Variables → Production / Preview 都添加此变量
# Cloudflare Workers：wrangler secret put DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# === 可选：自定义 API Endpoint（默认 https://api.deepseek.com/v1/chat/completions，无需设置） ===
# DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
